{
  "name": "nace-migration-agent",
  "version": "0.1.0",
  "description": "Find the LLM and document-processing calls in a codebase that can move to nace's Drex (decisions) and NDI (documents), estimate the cost before and after, and migrate them",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "nace-migration-agent": "dist/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "node scripts/bundle.mjs",
    "build": "npm run typecheck && npm run bundle",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "live-check": "tsx scripts/live-check.ts"
  },
  "files": [
    "dist/",
    "skills/",
    ".agents/",
    ".claude-plugin/",
    ".mcp.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "nace",
    "drex",
    "ndi",
    "mcp",
    "claude-code",
    "cursor",
    "migration",
    "cost-reduction"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "4.1.11"
  }
}
